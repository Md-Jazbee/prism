{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.dev/schemas/events/v0/events.schema.json",
  "title": "Prism metrics / observability events v0",
  "version": "0.0.1",
  "events": {
    "index_started": {
      "fields": ["schema_version", "root"]
    },
    "index_finished": {
      "fields": [
        "files_discovered",
        "files_skipped_unchanged",
        "files_hashed",
        "files_secret_skipped",
        "files_extracted",
        "files_extract_skipped",
        "nodes_written",
        "edges_written",
        "unresolved_calls",
        "wall_time_ms"
      ]
    },
    "file_skipped_secret": {
      "fields": ["path"]
    },
    "file_extract_skipped": {
      "fields": ["path", "reason"]
    },
    "file_extracted": {
      "fields": ["path", "language", "nodes", "edges", "unresolved_calls"],
      "notes": "Unresolved call rate = unresolved_calls / CALLS edges (per language dashboards in Stage D)"
    },
    "query_finished": {
      "fields": ["op", "latency_ms", "hit_count"],
      "notes": "Track toward local structural query P95 <50ms (design NFR)"
    },
    "slice_finished": {
      "fields": [
        "depth_reached",
        "functions_visited",
        "spans",
        "truncated",
        "memo_hit",
        "latency_ms",
        "shard_build_ms"
      ],
      "notes": "P4 Stage B inter-procedural Slice operator"
    },
    "placeholders_later": {
      "tokens_per_task": "eval harness",
      "tool_calls_per_task": "eval harness"
    }
  }
}
